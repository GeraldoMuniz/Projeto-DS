# Server
PORT=3000
NODE_ENV=development
API_PREFIX=gerinfra/api

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=gerinfra

# Usada diretamente pelo Prisma CLI (migrations/generate); a aplicação também aceita
# só as variáveis DB_* acima e monta essa URL em runtime (ver src/config/database.config.ts).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gerinfra

# Swagger
SWAGGER_TITLE=Gerinfra API
SWAGGER_DESCRIPTION=API de gestão de manutenção predial
SWAGGER_VERSION=1.0.0
SWAGGER_PATH=api/docs

# Keycloak — obrigatório para os endpoints protegidos do Gerinfra
# Valores abaixo já batem com o realm gerado em setup/realm.json e importado
# pelo serviço `keycloak` do docker-compose.yml.
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8080/auth
KEYCLOAK_REALM=Local
KEYCLOAK_CLIENT_ID=gerinfra-back
KEYCLOAK_JWKS_CACHE_MAX_AGE=600000
KEYCLOAK_JWKS_TIMEOUT=5000

# Opcional: URL interna do endpoint de chaves em containers; issuer continua público.
# KEYCLOAK_JWKS_URL=http://keycloak:8080/auth/realms/Local/protocol/openid-connect/certs
